{
  "name": "@kalagh/mcp",
  "version": "1.0.0",
  "description": "MCP server for a Kalagh provider — every provider operation as a tool, over REST, Socket.IO or gRPC",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "kalagh-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && ln -sfn ../schema dist-test/schema && node --test \"dist-test/test/**/*.test.js\"",
    "sync-schema": "node scripts/sync-schema.mjs",
    "bundle": "node scripts/bundle.mjs",
    "pack:mcpb": "pnpm build && pnpm bundle && mcpb validate bundle/manifest.json && mcpb pack bundle kalagh.mcpb",
    "inspect": "pnpm build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "clean": "rm -rf dist dist-test bundle *.mcpb"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
